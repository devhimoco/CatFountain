// ── Schedule (time-of-day triggers) ─────────────────────────
// Needs NTP — see TZ_OFFSET_SEC above. Persisted to NVS as a raw struct
// blob, same "fountain" namespace as every other saved setting.
#define MAX_SCHEDULES 8
struct ScheduleEntry {
  uint8_t  hour;         // 0-23
  uint8_t  minute;       // 0-59
  uint16_t durationSec;  // MIN_SEC..MAX_SEC
  bool     enabled;
  bool     firedToday;   // reset at local-midnight rollover, not persisted
};
ScheduleEntry schedules[MAX_SCHEDULES];
uint8_t       scheduleCount   = 0;
int           lastScheduleDay = -1;   // tm_yday of the last rollover check
bool          timeSynced      = false;

// ── Recent activity log (RAM ring buffer, cleared on reboot) ─
#define MAX_LOG_ENTRIES 15
struct LogEntry { unsigned long ms; String msg; };
LogEntry eventLog[MAX_LOG_ENTRIES];
uint8_t  logHead  = 0;
uint8_t  logCount = 0;
void logEvent(const String &msg) {
  eventLog[logHead] = { millis(), msg };
  logHead = (logHead + 1) % MAX_LOG_ENTRIES;
  if (logCount < MAX_LOG_ENTRIES) logCount++;
}

// ── Persistent boot/crash history (survives every reset type) ──
// Unlike the RAM activity log above (wiped by the very reset we're
// trying to diagnose), this is written to flash at the start of every
// boot — including right after a brownout or watchdog reset — so it
// survives exactly the events we need to see. Kept deliberately small
// (10 entries × 5 bytes) since NVS gets a real write every single boot;
// a crash-loop scenario could write fairly often, so this stays tiny
// and simple rather than anything heavier.
#define MAX_BOOT_HISTORY 10
struct BootRecord {
  uint8_t  reason;         // esp_reset_reason_t value
  uint32_t freeHeapAtBoot; // bytes
};
BootRecord bootHistory[MAX_BOOT_HISTORY];
uint8_t    bootHistoryCount = 0;
uint32_t   minFreeHeapSeen  = UINT32_MAX;   // lowest free heap seen THIS session

const char* resetReasonStr(uint8_t r) {
  switch ((esp_reset_reason_t)r) {
    case ESP_RST_POWERON:   return "Power-on";
    case ESP_RST_EXT:       return "External reset";
    case ESP_RST_SW:        return "Software (restart button)";
    case ESP_RST_PANIC:     return "PANIC (crash)";
    case ESP_RST_INT_WDT:   return "Interrupt watchdog";
    case ESP_RST_TASK_WDT:  return "Task watchdog";
    case ESP_RST_WDT:       return "Other watchdog";
    case ESP_RST_BROWNOUT:  return "BROWNOUT (power dip)";
    case ESP_RST_SDIO:      return "SDIO";
    case ESP_RST_DEEPSLEEP: return "Deep sleep wake";
    default:                return "Unknown";
  }
}

void loadBootHistory() {
  prefs.begin("fountain", true);
  bootHistoryCount = prefs.getUChar("boot_n", 0);
  if (bootHistoryCount > MAX_BOOT_HISTORY) bootHistoryCount = MAX_BOOT_HISTORY;
  size_t len = prefs.getBytes("boot_hist", bootHistory, sizeof(bootHistory));
  if (len != sizeof(bootHistory)) { bootHistoryCount = 0; memset(bootHistory, 0, sizeof(bootHistory)); }
  prefs.end();
}

// Records THIS boot's reset reason, shifting older entries down (index 0
// = most recent). Called once, very early in setup().
void recordBootReason() {
  loadBootHistory();
  esp_reset_reason_t reason = esp_reset_reason();

  int keep = (bootHistoryCount < MAX_BOOT_HISTORY) ? bootHistoryCount : (MAX_BOOT_HISTORY - 1);
  for (int i = keep - 1; i >= 0; i--) bootHistory[i + 1] = bootHistory[i];
  bootHistory[0] = { (uint8_t)reason, (uint32_t)ESP.getFreeHeap() };
  if (bootHistoryCount < MAX_BOOT_HISTORY) bootHistoryCount++;

  prefs.begin("fountain", false);
  prefs.putUChar("boot_n", bootHistoryCount);
  prefs.putBytes("boot_hist", bootHistory, sizeof(bootHistory));
  prefs.end();

  Serial.printf("[Boot] Reason: %s | Free heap: %u bytes\n", resetReasonStr(reason), ESP.getFreeHeap());
}

String buildBootHistoryJson() {
  String j = "[";
  for (uint8_t i = 0; i < bootHistoryCount; i++) {
    if (i) j += ",";
    j += "{\"reason\":\"" + String(resetReasonStr(bootHistory[i].reason)) + "\","
       + "\"heap_kb\":" + String(bootHistory[i].freeHeapAtBoot / 1024) + "}";
  }
  j += "]";
  return j;
}

